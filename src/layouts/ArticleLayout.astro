---
import BaseLayout from './BaseLayout.astro';
import Figure from '../components/Figure.astro';
import Toc from '../components/Toc.astro';
import { formats, type FormatId } from '../lib/editorial';
import type { ImageMetadata } from 'astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import { categoryLabels, site, owner, ownerReady } from '../lib/site';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  verified?: string;
  publishDate: Date;
  updatedDate?: Date;
  headings?: Heading[];
  format?: FormatId;
  hero?: ImageMetadata;
  heroRemote?: string;
  heroAlt?: string;
  heroCredit?: string;
}
const {
  id, title, description, category, verified, publishDate, updatedDate,
  headings = [], format, hero, heroRemote, heroAlt, heroCredit,
} = Astro.props as Props;
const formatDef = format ? formats[format] : undefined;
const fmt = (d: Date) => d.toISOString().slice(0, 10).replace(/-/g, '.');

const base = Astro.site ?? new URL(site.url);
const pageUrl = new URL(`/articles/${id}/`, base).href;
const label = categoryLabels[category] ?? category;

// 構造化データ。レビュー媒体は著者と更新日が評価されるため明示する
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    datePublished: publishDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    image: new URL('/og.png', base).href,
    articleSection: label,
    ...(ownerReady
      ? { author: { '@type': 'Person', name: owner.name },
          publisher: { '@type': 'Organization', name: site.name } }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', base).href },
      { '@type': 'ListItem', position: 2, name: label, item: new URL(`/category/${category}/`, base).href },
      { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
    ],
  },
];
---
<BaseLayout title={title} description={description} ogType="article" schema={schema} ogImage={heroRemote?.startsWith('/thumbs/') ? heroRemote : undefined}>
  <article class="wrap--narrow article">
    <nav class="crumbs" aria-label="パンくず">
      <a href="/">ホーム</a>
      <span aria-hidden="true">/</span>
      <a href={`/category/${category}/`}>{categoryLabels[category] ?? category}</a>
    </nav>

    <header class="article__head">
      <h1>{title}</h1>
      <div class="article__meta">
        {formatDef && <span class="article__fmt">{formatDef.badge}</span>}
        {verified && <span class="badge">{verified}</span>}
        <time datetime={publishDate.toISOString()}>公開 {fmt(publishDate)}</time>
        {updatedDate && <time datetime={updatedDate.toISOString()}>更新 {fmt(updatedDate)}</time>}
      </div>
      <p class="article__lead">{description}</p>
      <p class="disclosure">
        本記事にはアフィリエイトリンクを含みます。評価は実機の使用と実測に基づき、
        紹介料の有無で順位を変えることはありません。
      </p>
    </header>

    {(hero || heroRemote) && (
      <Figure
        src={(hero ?? heroRemote)!}
        alt={heroAlt ?? title}
        credit={heroCredit}
        width={880}
      />
    )}

    <Toc headings={headings} />

    <div class="prose">
      <slot />
    </div>

    <RelatedArticles currentId={id} category={category} />
  </article>
</BaseLayout>

<style>
  .article { padding: 2.5rem 0 0; }
  .crumbs { display: flex; gap: .5rem; font-size: .8rem; color: var(--ink-faint); margin-bottom: 1.5rem; }
  .crumbs a { color: var(--ink-faint); text-decoration: none; }
  .crumbs a:hover { color: var(--amber); }
  .article__head { padding-bottom: 1.8rem; border-bottom: 1px solid var(--rule); }
  .article__meta { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; margin: .9rem 0; font-family: var(--num); font-size: .78rem; color: var(--ink-faint); }
  .article__fmt { padding: .2em .7em; border: 1px solid var(--rule); border-radius: 999px; font-family: var(--sans); font-size: .72rem; font-weight: 700; color: var(--ink-faint); }
  .article__lead { font-size: 1.02rem; color: var(--ink-soft); margin: 1rem 0 1.3rem; }
</style>
