---
import { site } from '../lib/site';
const { pathname } = Astro.url;
---
<header class="site-head">
  <div class="wrap site-head__inner">
    <a href="/" class="brand" aria-label={`${site.name} ホーム`}>
      <svg class="brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M3 16 Q16 5.5 29 16 Q16 26.5 3 16 Z" fill="currentColor"/>
        <ellipse cx="16" cy="16" rx="5.4" ry="7.6" fill="var(--amber)"/>
        <path d="M16 9 Q17.9 16 16 23 Q14.1 16 16 9 Z" fill="var(--paper)"/>
      </svg>
      <span class="brand__text">
        <strong>neko-tech</strong>
        <small>{site.tagline}</small>
      </span>
    </a>

    <nav aria-label="カテゴリ">
      <ul class="nav">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={pathname.startsWith(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav__tool">
          <a href={site.tools[0].href}>{site.tools[0].label}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-head {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    position: sticky; top: 0; z-index: 20;
  }
  .site-head__inner {
    display: flex; align-items: center; justify-content: space-between;
    gap: 1.5rem; padding: .9rem 0; flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
  /* 猫の目をモチーフにした記号。イラスト素材に依存せず図形だけで作る */
  .brand__mark { width: 1.75rem; height: 1.75rem; flex: none; color: var(--ink); }
  .brand__text { display: flex; flex-direction: column; line-height: 1.25; }
  .brand__text strong { font-size: 1.15rem; letter-spacing: -.02em; }
  .brand__text small { font-size: .72rem; color: var(--ink-faint); }

  .nav { display: flex; align-items: center; gap: 1.15rem; margin: 0; padding: 0; list-style: none; flex-wrap: wrap; }
  .nav a {
    font-size: .92rem; font-weight: 700; text-decoration: none; color: var(--ink-soft);
    padding-bottom: 2px; border-bottom: 2px solid transparent;
  }
  .nav a:hover { color: var(--ink); border-bottom-color: var(--amber); }
  .nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  .nav__tool a {
    padding: .35em .85em; border: 1.5px solid var(--data); border-radius: 999px;
    color: var(--data); font-size: .85rem;
  }
  .nav__tool a:hover { background: var(--data); color: #fff; border-bottom-color: var(--data); }

  @media (max-width: 640px) {
    .site-head { position: static; }
    .site-head__inner { padding: .8rem 0; }
    .nav { gap: .8rem; font-size: .85rem; }
  }
</style>
