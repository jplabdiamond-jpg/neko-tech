---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * 記事内の画像。自前撮影（ImageMetadata）とリモートURL（楽天API）の両方を扱う。
 * ローカル画像はAstroが最適化し、サイズ属性を付けてレイアウトシフトを防ぐ。
 */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  /** 実測値のキャプションなど、データとして見せたい場合 */
  data?: boolean;
  width?: number;
}
const { src, alt, caption, credit, data = false, width = 880 } = Astro.props as Props;
const isLocal = typeof src !== 'string';
---
<figure class:list={['fig', data && 'fig--data']}>
  {isLocal ? (
    <Image src={src} alt={alt} width={width} densities={[1, 2]} loading="lazy" decoding="async" />
  ) : (
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  )}
  {(caption || credit) && (
    <figcaption>
      {caption}
      {credit && <span class="fig__credit">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .fig { margin: 2rem 0; }
  .fig img { width: 100%; height: auto; border-radius: var(--radius-lg); background: var(--paper-sunk); }
  .fig figcaption { margin-top: .6rem; font-size: .82rem; color: var(--ink-faint); line-height: 1.7; }
  .fig__credit { display: block; margin-top: .2rem; font-size: .74rem; }
  .fig--data img { border: 1px solid var(--rule); }
</style>
