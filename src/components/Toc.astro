---
/** 長い比較記事では目次が回遊と滞在時間に直結する。h2のみを拾う。 */
interface Heading { depth: number; slug: string; text: string }
interface Props { headings: Heading[] }
const { headings } = Astro.props as Props;
const items = headings.filter((h) => h.depth === 2);
---
{items.length >= 3 && (
  <nav class="toc" aria-labelledby="toc-title">
    <p class="toc__title" id="toc-title">目次</p>
    <ol>
      {items.map((h) => (
        <li><a href={`#${h.slug}`}>{h.text}</a></li>
      ))}
    </ol>
  </nav>
)}

<style>
  .toc { margin: 2rem 0; padding: 1.2rem 1.4rem; background: var(--paper-sunk); border-radius: var(--radius-lg); }
  .toc__title { margin: 0 0 .7rem; font-size: .78rem; font-weight: 700; letter-spacing: .12em; color: var(--ink-faint); }
  .toc ol { margin: 0; padding-left: 1.2rem; }
  .toc li { margin: .4rem 0; font-size: .92rem; line-height: 1.6; }
  .toc a { color: var(--ink-soft); text-decoration: none; }
  .toc a:hover { color: var(--amber); text-decoration: underline; }
</style>
