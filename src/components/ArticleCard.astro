---
import { categoryLabels } from '../lib/site';
interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  verified?: string;
  date: Date;
}
const { href, title, description, category, verified, date } = Astro.props as Props;
const d = date.toISOString().slice(0, 10).replace(/-/g, '.');
---
<article class="acard">
  <div class="acard__meta">
    <span class="acard__cat">{categoryLabels[category] ?? category}</span>
    {verified && <span class="badge">{verified}</span>}
  </div>
  <h3 class="acard__title"><a href={href}>{title}</a></h3>
  <p class="acard__desc">{description}</p>
  <time class="acard__date" datetime={date.toISOString()}>{d}</time>
</article>

<style>
  .acard { padding: 1.3rem 0; border-top: 1px solid var(--rule); }
  .acard__meta { display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; margin-bottom: .5rem; }
  .acard__cat { font-size: .75rem; font-weight: 700; letter-spacing: .06em; color: var(--amber); }
  .acard__title { font-size: 1.12rem; line-height: 1.5; margin-bottom: .4rem; }
  .acard__title a { text-decoration: none; }
  .acard__title a:hover { text-decoration: underline; text-decoration-color: var(--amber); text-decoration-thickness: 2px; }
  .acard__desc { margin: 0 0 .5rem; font-size: .92rem; color: var(--ink-soft); line-height: 1.75; }
  .acard__date { font-family: var(--num); font-size: .76rem; color: var(--ink-faint); }
</style>
